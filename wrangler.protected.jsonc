{
  "name": "euro5-tender-test",
  "main": "access-worker.js",
  "compatibility_date": "2026-10-23",
  "assets": {"directory": "./protected-public", "binding": "ASSETS", "run_worker_first": true},
  "vars": {"MEMORY_ENABLED": "1", "MEMORY_AUTH_MODE": "session", "TEST_LOGIN_ENABLED": "1"},
  "d1_databases": [{"binding": "EURO5_MEMORY_DB", "database_name": "euro5-project-memory", "database_id": "REPLACE_WITH_EXISTING_D1_ID", "migrations_dir": "migrations"}]
}
